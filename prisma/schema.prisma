generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Admin {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admin")
}

// Paket Internet (SGC HEMAT, SGC LITE, SGC SOCIALLY, SGC FAMILY)
model Package {
  id               Int              @id @default(autoincrement())
  categoryId       Int?
  category         ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name             String           @db.VarChar(100)           // "SGC HEMAT"
  tierLabel        String           @db.VarChar(50)            // "Pemula / Hemat"
  tierNumber       String           @db.VarChar(10)            // "Tier 1"
  description      String           @db.VarChar(500)           // Short desc
  speedMbps        Int                                  // 5, 16, 26, 56
  priceMonthly     Int                                  // 130000 (in Rupiah)
  activationFee    Int      @default(150000)
  features         String   @db.Text                   // JSON string: [{text, included: true/false}]
  isFeatured       Boolean  @default(false)            // "Paling Diminati" badge
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("packages")
}

// Voucher Hotspot (Eceran & Reseller)
model VoucherPlan {
  id              Int              @id @default(autoincrement())
  categoryId      Int?
  category        ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name            String           @db.VarChar(100)            // "Voucher Eceran (8 Jam)"
  type            String           @db.VarChar(20)             // "retail" | "reseller"
  tagLabel        String           @db.VarChar(50)             // "Pengguna Langsung" | "Harga Grosir Mitra"
  price           Int                                   // 3000 | 2000
  priceUnit       String           @db.VarChar(50)             // "/ voucher"
  duration        String           @db.VarChar(50)             // "Masa aktif 8 jam sejak login"
  minPurchase     String?          @db.VarChar(100)            // "Min. 25 Pcs (Modal Rp 50k)"
  features        String   @db.Text                    // JSON string: string[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("voucher_plans")
}

// FAQ
model Faq {
  id         Int              @id @default(autoincrement())
  categoryId Int?
  category   ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  question   String           @db.VarChar(500)
  answer     String           @db.Text
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@map("faqs")
}

// Testimonial pelanggan (tanpa initials dan rating)
model Testimonial {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100)              // "Budi Santoso"
  role      String   @db.VarChar(255)              // "Pelanggan Rumah Tangga (Arjawinangun)"
  quote     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("testimonials")
}

// Site Settings (single row, dipersingkat seperlunya & ada logo)
model SiteSettings {
  id               Int      @id @default(autoincrement())
  companyName      String   @db.VarChar(100)  // "PT Jaringan Multimedia Cirebon"
  brandName        String   @db.VarChar(50)   // "JMCNET"
  logo             String?  @db.VarChar(255)  // URL gambar logo di uploads/
  tagline          String   @db.VarChar(255)  // "100% Fiber Optic Cirebon"
  whatsappCs1      String   @db.VarChar(20)   // "6285179997972"
  whatsappCs2      String   @db.VarChar(20)   // "6285179997975"
  email            String   @db.VarChar(100)  // "info@jmcnet.id"
  address          String   @db.Text          // "Arjawinangun, Cirebon, Jawa Barat"
  operationalHours String   @db.VarChar(100)  // "Senin - Sabtu (09:00 - 18:00)"
  heroHeadline     String   @db.VarChar(255)  // "Dedikasi Menghubungkan Cirebon Tanpa Batas"
  heroSubtext      String   @db.Text          // Deskripsi hero
  aboutTitle       String   @db.VarChar(255)  // "PT Jaringan Multimedia Cirebon (SGC Network)"
  aboutDescription String   @db.Text          // Deskripsi tentang perusahaan
  registrationForm String?  @db.VarChar(255)  // URL file formulir pendaftaran di uploads/
  serviceContract  String?  @db.VarChar(255)  // URL file kontrak berlangganan di uploads/
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("site_settings")
}

// Chatbot Context (Knowledge Base Teks)
model ChatbotContext {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(100)
  context   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("chatbot_contexts")
}

// Chatbot File (Knowledge Base dari File PDF/Excel/Word)
model ChatbotFile {
  id        Int      @id @default(autoincrement())
  filename  String   @db.VarChar(255)
  filePath  String   @db.VarChar(255)
  fileUrl   String   @db.VarChar(255)
  content   String   @db.LongText
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("chatbot_files")
}

model ServiceCategory {
  id           Int           @id @default(autoincrement())
  name         String        @db.VarChar(100)
  slug         String        @unique @db.VarChar(100)
  description  String?       @db.VarChar(255)
  packages     Package[]
  voucherPlans VoucherPlan[]
  faqs         Faq[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("service_categories")
}
